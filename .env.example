# TP-HR Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME="TP-HR"
APP_ENV=development
# In production use APP_ENV=production and omit APP_DEBUG (defaults false) or set APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost/tp-hr
# Public CRM URL (LINE Flex logo, SSO links). Production: https://crm.tp-asset.com
CRM_BASE_URL=http://localhost/tp-crm

# Database (shared with TP-CRM)
# Many teams point dev .env at the same MySQL as production (or a read replica) so
# schema and settings stay current. A long-stale local dump will miss HR tables and
# tools like scripts/production_preflight.php will report many false failures.
# Use a least-privilege DB user where possible; never commit a real .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tp_crm
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=7200

# How long an installed-PWA session stays signed in (sliding window, seconds).
# 1209600 = 14 days. Set 0 to restore the pre-PWA behaviour: the cookie dies
# with the browser session and the idle timeout drops back to 1 hour.
PWA_SESSION_LIFETIME=1209600

# Web Push (PWA notifications). Generate once with:
#   php scripts/generate_vapid_keys.php
# Leave blank to keep push disabled — the app hides the feature entirely.
# Regenerating these invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@tp-asset.com

# Health check GET /api/health (TpCommon\HealthCheck when tp-common is installed)
# Production: set HEALTH_CHECK_TOKEN so only monitors get full JSON diagnostics (?token= or X-Health-Check-Token).
# Optional: HEALTH_CHECK_RATE_LIMIT_PER_MIN=120 (per client IP, rolling minute; 0 or omit = disabled)
# HEALTH_CHECK_TOKEN=
# HEALTH_CHECK_RATE_LIMIT_PER_MIN=

# File Storage
MAX_UPLOAD_SIZE=10485760

# Email (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hr@company.com
MAIL_FROM_NAME="TP-HR System"

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=

# Google Maps (for GPS check-in)
GOOGLE_MAPS_API_KEY=

# Related Systems (ตั้งค่าตาม ADR-0001)
#
# TP-Checkin — รูปลงเวลาใน DB เป็น path เช่น photos/checkin/2026/04/checkin_2_....jpeg
#
# แบบ A (แนะนำเมื่อ HR กับ Check-in คนละโดเมน เช่น hr.* กับ checkin.*):
#   ตั้ง CHECKIN_APP_URL ให้ตรงกับ URL ฐานของแอป Check-in (ที่เปิด .../storage/photos/... ได้)
#   ตัวอย่าง production:
#   CHECKIN_APP_URL=https://checkin.tp-asset.com
#   ถ้า Check-in อยู่ใต้ path (เช่น /tp-checkin) ให้ใส่รวม path: https://example.com/tp-checkin
#
# แบบ B (HR กับ Check-in อยู่เครื่องเดียวกัน แชร์โฟลเดอร์ได้):
#   ตั้ง CHECKIN_STORAGE_PATH เป็น path จริงไปที่โฟลเดอร์ storage ของ TP-Checkin
#   ระบบจะใช้ /api/checkin_storage_image.php บนโดเมน HR (ส่งคุกกี้เซสชันเดียวกับหน้า HR)
#
CHECKIN_APP_URL=http://localhost/tp-checkin
CHECKIN_STORAGE_PATH=
TP_CRM_URL=http://localhost/tp-crm
# Alias of CRM_BASE_URL for legacy references; keep both in sync on production.
# Optional: absolute path to tp-crm on disk (for LINE bridge / require_once). Default: sibling folder ../tp-crm
# TP-CRM on disk (LINE bridge loads tp-crm/.env for LINE_CHANNEL_ACCESS_TOKEN automatically)
# TP_CRM_PATH=/Applications/XAMPP/xamppfiles/htdocs/tp-crm
TP_CRM_API_URL=http://localhost/tp-crm/api
TP_CRM_API_KEY=

# Optional: GitHub auto-deploy webhook (/webhook.php) — must match repo webhook secret
# WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Naming convention is already aligned with ADR-0001 (env naming standard).
# See: ../tp-docs/adr/0001-env-naming-standard.md
# -----------------------------------------------------------------------------
