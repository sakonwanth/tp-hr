# TP-HR — copy to .env (do not commit .env)
# Uses same MySQL schema as TP-CRM unless you split databases intentionally.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/tp-hr

# Database (typically shared with TP-CRM)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tp_crm
DB_USER=root
DB_PASS=

# SSO: central staff login (same variable name as TP-ERP; CRM_URL is accepted as alias)
CRM_BASE_URL=http://localhost/tp-crm

# Optional: shared Redis session with CRM/ERP/Check-in (multi-server)
# SESSION_REDIS_HOST=127.0.0.1
# SESSION_REDIS_PORT=6379
# SESSION_REDIS_PASSWORD=
# SESSION_COOKIE_DOMAIN=
