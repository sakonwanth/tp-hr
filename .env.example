# TP-HR Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME="TP-HR"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/tp-hr

# Database (shared with TP-CRM)
# Many teams point dev .env at the same MySQL as production (or a read replica) so
# schema and settings stay current. A long-stale local dump will miss HR tables and
# tools like scripts/production_preflight.php will report many false failures.
# Use a least-privilege DB user where possible; never commit a real .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tp_crm
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=7200

# File Storage
MAX_UPLOAD_SIZE=10485760

# Email (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hr@company.com
MAIL_FROM_NAME="TP-HR System"

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=

# Google Maps (for GPS check-in)
GOOGLE_MAPS_API_KEY=

# Related Systems (ตั้งค่าตาม ADR-0001)
# ฐาน URL ของ TP-Checkin — ใช้แสดงรูปลงเวลาใน HR (ไฟล์อยู่ที่ {CHECKIN_APP_URL}/storage/photos/...)
CHECKIN_APP_URL=http://localhost/tp-checkin
TP_CRM_URL=http://localhost/tp-crm
# Optional: absolute path to tp-crm on disk (for LINE bridge / require_once). Default: sibling folder ../tp-crm
# TP_CRM_PATH=/Applications/XAMPP/xamppfiles/htdocs/tp-crm
TP_CRM_API_URL=http://localhost/tp-crm/api
TP_CRM_API_KEY=

# -----------------------------------------------------------------------------
# Naming convention is already aligned with ADR-0001 (env naming standard).
# See: ../tp-docs/adr/0001-env-naming-standard.md
# -----------------------------------------------------------------------------
