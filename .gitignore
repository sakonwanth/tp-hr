# Environment
.env
.env.local
.env.*.local

# Secrets & Keys (defense-in-depth)
*.key
*.pem
*.pfx
*.crt
id_rsa*
secrets/
.secrets/

# Dependencies
/vendor/
/node_modules/

# Storage
/storage/uploads/*
/storage/documents/*
/storage/temp/*
/storage/cache/*
!/storage/cache/.gitkeep
!/storage/.gitkeep
!/storage/uploads/.gitkeep
!/storage/documents/.gitkeep
!/storage/temp/.gitkeep

# Logs
*.log
/logs/*
!/logs/.gitkeep

# IDE
.idea/
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Misc
*.bak
*.tmp
*.swp

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/playwright/.auth/
