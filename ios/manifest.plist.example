<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ad Hoc install manifest for TP-HR.

  Copy to manifest.plist next to the .ipa and fill in the version. Both files
  must be served over HTTPS with a certificate iOS trusts — a self-signed cert
  fails with a generic "Cannot connect" and no useful diagnostic.

  bundle-identifier must match PRODUCT_BUNDLE_IDENTIFIER in the Xcode project
  (com.tpasset.tphr). A mismatch installs a *second* app instead of updating
  the existing one.

  manifest.plist is gitignored — it is generated per release.
-->
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>
        <dict>
          <key>kind</key>
          <string>software-package</string>
          <key>url</key>
          <string>https://hr.tp-asset.com/ios/TP-HR.ipa</string>
        </dict>
        <dict>
          <key>kind</key>
          <string>display-image</string>
          <key>url</key>
          <string>https://hr.tp-asset.com/assets/icons/icon-192-v2.png</string>
        </dict>
        <dict>
          <key>kind</key>
          <string>full-size-image</string>
          <key>url</key>
          <string>https://hr.tp-asset.com/assets/icons/icon-512-v2.png</string>
        </dict>
      </array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key>
        <string>com.tpasset.tphr</string>
        <key>bundle-version</key>
        <string>1.0.0</string>
        <key>kind</key>
        <string>software</string>
        <key>title</key>
        <string>TP-HR</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
